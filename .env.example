# Air Fare Index — Environment Variables
# Copy this file to .env and fill in the values.
# The .env file must NEVER be committed to version control.
#
# IMPORTANT:
# - AVIATIONSTACK_API_KEY is server-side ONLY.
# - Do NOT prefix it with VITE_ — that would expose it to the browser bundle.
# - The Vite dev proxy reads this via process.env on the server side.

AVIATIONSTACK_API_KEY=your_actual_key_here
AVIATIONSTACK_BASE_URL=https://api.aviationstack.com/v1
