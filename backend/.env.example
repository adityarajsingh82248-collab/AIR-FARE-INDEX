NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:password@localhost:5432/airindex
SESSION_SECRET=your_random_session_secret_minimum_32_characters
FRONTEND_URL=http://localhost:5173

# Google OAuth 2.0 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# Admin Seeding (npm run seed:admin)
ADMIN_NAME=AirIndex Administrator
ADMIN_EMAIL=admin@airindex.gov.in
ADMIN_PASSWORD=AdminSecurePassphrase2026!
