<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="200" height="200">
  <defs>
    <linearGradient id="circleGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0284c7" />
      <stop offset="100%" stop-color="#0f172a" />
    </linearGradient>
    <path id="textCircleTop" d="M 30,100 A 70,70 0 0,1 170,100" fill="none" />
    <path id="textCircleBottom" d="M 170,100 A 70,70 0 0,1 30,100" fill="none" />
  </defs>
  
  <!-- Outer border -->
  <circle cx="100" cy="100" r="95" fill="#ffffff" stroke="#0ea5e9" stroke-width="3" />
  <circle cx="100" cy="100" r="90" fill="#f8fafc" stroke="#0f172a" stroke-width="1.5" stroke-dasharray="3,3" />
  
  <!-- Text Ring -->
  <text font-family="Inter, system-ui, sans-serif" font-size="11" font-weight="700" fill="#0f172a" letter-spacing="2.5">
    <textPath href="#textCircleTop" startOffset="50%" text-anchor="middle">
      DATA FOR DEVELOPMENT
    </textPath>
  </text>
  
  <text font-family="Inter, system-ui, sans-serif" font-size="9" font-weight="600" fill="#0284c7" letter-spacing="2">
    <textPath href="#textCircleBottom" startOffset="50%" text-anchor="middle">
      • MOSPI INDIA •
    </textPath>
  </text>

  <!-- Inner Center Shield / Circle -->
  <circle cx="100" cy="100" r="54" fill="url(#circleGrad)" stroke="#38bdf8" stroke-width="2" />
  
  <!-- Central analytics graph motif -->
  <!-- Bars -->
  <rect x="76" y="108" width="8" height="20" rx="2" fill="#38bdf8" />
  <rect x="88" y="98" width="8" height="30" rx="2" fill="#7dd3fc" />
  <rect x="100" y="88" width="8" height="40" rx="2" fill="#bae6fd" />
  <rect x="112" y="78" width="8" height="50" rx="2" fill="#ffffff" />
  
  <!-- Upward Trend Line with dots -->
  <polyline points="74,112 88,96 102,86 120,72" fill="none" stroke="#fbbf24" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
  <circle cx="74" cy="112" r="3" fill="#fbbf24" />
  <circle cx="88" cy="96" r="3" fill="#fbbf24" />
  <circle cx="102" cy="86" r="3" fill="#fbbf24" />
  <circle cx="120" cy="72" r="4" fill="#ffffff" stroke="#fbbf24" stroke-width="2" />
</svg>
