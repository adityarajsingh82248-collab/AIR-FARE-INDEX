APP_ENV=DEVELOPMENT
COLLECTION_MODE=fixture
DATABASE_URL=postgresql://air_index:CHANGE_ME@localhost:5432/air_index
REDIS_URL=redis://localhost:6379/0
POSTGRES_DB=air_index
POSTGRES_USER=air_index
POSTGRES_PASSWORD=CHANGE_ME
# Production must use COLLECTION_MODE=live and an explicitly authorized LIVE source.
# IndiGo NDC (only after authorized UAT/production onboarding)
INDIGO_NDC_BASE_URL=https://client.ndc.navitaire.com
INDIGO_NDC_AUTH_PATH=/v21.3/Authentication
INDIGO_NDC_AIRSHOPPING_PATH=/v21.3/AirShopping
INDIGO_NDC_SUBSCRIPTION_KEY=CHANGE_ME
INDIGO_NDC_USERNAME=CHANGE_ME
INDIGO_NDC_PASSWORD=CHANGE_ME
INDIGO_NDC_TIMEOUT_SECONDS=30
